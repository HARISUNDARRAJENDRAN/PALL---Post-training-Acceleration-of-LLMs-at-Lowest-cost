# Hugging Face credentials and repo targets.
HF_TOKEN=hf_your_write_token_here
HF_TOKEN_READ=hf_your_read_token_here
HF_USERNAME=Harisundar
HF_DATA_REPO=Harisundar/pall
HF_MODEL_REPO=Harisundar/pall-llama3.1-8b-sft

# Vast.ai cache defaults.
HF_HOME=/workspace/.hf_cache
TRANSFORMERS_CACHE=/workspace/.hf_cache
HF_DATASETS_CACHE=/workspace/.hf_cache/datasets
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_ENABLE_HF_TRANSFER=1
TRANSFORMERS_NO_ADVISORY_WARNINGS=1
TOKENIZERS_PARALLELISM=true
