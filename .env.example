# =====================================================================
# PALL — environment template. Copy to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.
# =====================================================================

# --- Hugging Face (required for training + dataset/model pull) ---
HF_TOKEN=hf_your_write_token_here          # write access: push adapters/models
HF_TOKEN_READ=hf_your_read_token_here      # read access: pull private datasets
HF_USERNAME=Harisundar
HF_DATA_REPO=Harisundar/pall               # CPT/SFT/DPO dataset repo
HF_MODEL_REPO=Harisundar/pall-llama3.1-8b-cpt-sft-dpo-v3

# --- LLM-judge APIs (only needed for open-ended evaluation / DPO pair scoring) ---
# DeepSeek and/or Gemini are used as judges; supply whichever you use.
DEEPSEEK_API_KEY=
GEMINI_API_KEY1=
# (add GEMINI_API_KEY2.. if you rotate across multiple keys for rate limits)

# --- HF cache / runtime tuning (sensible defaults; override on cloud hosts) ---
HF_HOME=~/.cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1
HF_HUB_ENABLE_HF_TRANSFER=1
TRANSFORMERS_NO_ADVISORY_WARNINGS=1
TOKENIZERS_PARALLELISM=true
